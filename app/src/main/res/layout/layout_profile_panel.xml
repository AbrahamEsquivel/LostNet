<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000066"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/profilePanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_gravity="top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top Header: Close button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <ImageButton
                    android:id="@+id/btnCerrarPerfil"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    app:tint="#5F6368"
                    android:padding="8dp"/>
            </RelativeLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="40dp">

                    <!-- Profile Section Card style -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="24dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="24dp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <androidx.cardview.widget.CardView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                app:cardCornerRadius="40dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#E8F0FE">
                                <ImageView
                                    android:id="@+id/imgPerfilAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@android:drawable/ic_menu_myplaces"
                                    android:scaleType="centerCrop"/>
                            </androidx.cardview.widget.CardView>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/txtPerfilNombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Usuario LostNet"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#202124"/>

                            <TextView
                                android:id="@+id/txtPerfilEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="usuario@gmail.com"
                                android:textSize="14sp"
                                android:textColor="#5F6368"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:id="@+id/txtPerfilBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Buscador"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:background="@drawable/bg_badge_buscador"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Separador -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDE1E2"
                        android:layout_marginBottom="8dp"/>

                    <!-- Menu List style -->
                    <LinearLayout
                        android:id="@+id/menuMisReportes"
                        style="@style/LostNet_ProfileMenuItem">
                        <ImageView
                            style="@style/LostNet_ProfileMenuIcon"
                            android:src="@android:drawable/ic_menu_myplaces"/>
                        <TextView
                            style="@style/LostNet_ProfileMenuText"
                            android:text="Mis Reportes"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menuMisAlertas"
                        style="@style/LostNet_ProfileMenuItem">
                        <ImageView
                            style="@style/LostNet_ProfileMenuIcon"
                            android:src="@android:drawable/ic_popup_reminder"/>
                        <TextView
                            style="@style/LostNet_ProfileMenuText"
                            android:text="Mis Alertas"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDE1E2"
                        android:layout_marginVertical="8dp"/>

                    <LinearLayout
                        android:id="@+id/menuSobreApp"
                        style="@style/LostNet_ProfileMenuItem">
                        <ImageView
                            style="@style/LostNet_ProfileMenuIcon"
                            android:src="@android:drawable/ic_menu_info_details"/>
                        <TextView
                            style="@style/LostNet_ProfileMenuText"
                            android:text="Sobre la App"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menuCreditos"
                        style="@style/LostNet_ProfileMenuItem">
                        <ImageView
                            style="@style/LostNet_ProfileMenuIcon"
                            android:src="@android:drawable/ic_menu_agenda"/>
                        <TextView
                            style="@style/LostNet_ProfileMenuText"
                            android:text="Créditos"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDE1E2"
                        android:layout_marginVertical="8dp"/>

                    <LinearLayout
                        android:id="@+id/menuCerrarSesion"
                        style="@style/LostNet_ProfileMenuItem">
                        <ImageView
                            style="@style/LostNet_ProfileMenuIcon"
                            android:src="@android:drawable/ic_lock_power_off"
                            app:tint="#D93025"/>
                        <TextView
                            style="@style/LostNet_ProfileMenuText"
                            android:text="Cerrar Sesión"
                            android:textColor="#D93025"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
