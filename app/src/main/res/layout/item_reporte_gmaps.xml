<?xml version="1.0" encoding="utf-8"?>
<!-- Item de reporte estilo Google Maps para las listas del bottom sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Thumbnail cuadrado -->
    <androidx.cardview.widget.CardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/imgGmaps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:background="#F0F0F0"/>
    </androidx.cardview.widget.CardView>

    <!-- Datos del reporte -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <!-- Descripción -->
        <TextView
            android:id="@+id/txtGmapsDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Objeto perdido"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="3dp"/>

        <!-- Categoría • Estado -->
        <TextView
            android:id="@+id/txtGmapsCatEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electrónica · Perdido"
            android:textSize="12sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="6dp"/>

        <!-- Badge de estado -->
        <TextView
            android:id="@+id/txtGmapsEstadoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 PERDIDO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#D93025"/>

    </LinearLayout>

    <!-- Flecha / chevron -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@android:drawable/arrow_down_float"
        android:rotation="-90"
        android:alpha="0.4"/>

</LinearLayout>
